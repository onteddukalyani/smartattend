rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /admins/{adminId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /institution_settings/{docId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /institution/{docId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /lecturers/{lecturerId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /courses/{courseId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /students/{studentId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /users/{userId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /authorizedUsers/{userId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /faculty_notifications/{notificationId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /admin_notifications/{notificationId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /lecturer_notifications/{notificationId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /broadcast_notifications/{notificationId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /announcements/{announcementId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /broadcasts/{broadcastId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /user_complaints/{complaintId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }


    match /support_tickets/{ticketId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /feedbacks/{feedbackId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /security_complaints/{complaintId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /student_notifications/{studentRollNo} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /notifications/{notificationId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /app_updates/{docId} {
      // Any client can read update manifests to check for updates
      allow read: if true;
      // Prohibit all client-side writes. App updates can ONLY be published via Firebase Admin SDK / deployment scripts.
      // Do not trust exists(/admins/{uid}) while /admins may be publicly writable.
      allow write: if false;
      match /{document=**} {
        allow read: if true;
        allow write: if false;
      }
    }

    // =========================================================================
    // ATTENDANCE SESSIONS & SECURITY TOKENS
    // =========================================================================

    match /attendance_sessions/{sessionId} {
      // Authenticated users can read session documents
      allow read: if request.auth != null;

      // Creation: Only lecturers, admins, or users establishing session ownership
      allow create: if request.auth != null && (
        exists(/databases/$(database)/documents/lecturers/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.resource.data.ownerId == request.auth.uid
      );

      // Deletion: Only the session owner lecturer or an administrator
      allow delete: if request.auth != null && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.ownerEmail == request.auth.token.email
      );

      // Update: Lecturers and admins have full update authority.
      // Students CANNOT modify ownership, deadlines, active status, phase, kiosk settings, tokens, pins, or course metadata.
      allow update: if request.auth != null && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/lecturers/$(request.auth.uid)) ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.ownerEmail == request.auth.token.email ||
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'ownerId', 'ownerEmail', 'createdBy', 'lecturerName', 'lecturerEmail',
            'kioskEndsAt', 'expiresAt', 'qr1ExpiresAt', 'qr2StartsAt', 'sessionStartAt', 'startedAt', 'createdAt',
            'qr1DurationSeconds', 'qr2DurationSeconds', 'totalDurationSeconds', 'durationMinutes',
            'active', 'status', 'phase', 'kioskModeEnabled', 'strictKiosk',
            'qr1Token', 'qr2Token', 'qr1TokenHash', 'qr2TokenHash',
            'sessionPin', 'releaseCode', 'lecturerPin', 'lecturerReleaseCode',
            'sessionPinHash', 'lecturerPinHash', 'lecturerReleaseCodeHash', 'security',
            'courseId', 'courseCode', 'classCode', 'batch', 'department', 'semester',
            'geofence', 'geofenceEnabled', 'location'
          ])
        )
      );

      // Private Security Tokens: NEVER readable or writable by client SDKs
      // Only Cloud Functions Admin SDK can read/write tokens and Session PIN hashes
      match /security/{docId} {
        allow read, write: if false;
        match /{document=**} {
          allow read, write: if false;
        }
      }

      // Authorizations subcollection: student devices and lecturers
      // Students can only write to documents matching their authenticated UID or their own roll number
      match /authorizations/{authDocId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
          exists(/databases/$(database)/documents/lecturers/$(request.auth.uid)) ||
          request.auth.uid == authDocId ||
          (request.resource.data.studentUid == request.auth.uid && (resource == null || resource.data.studentUid == request.auth.uid))
        );
        match /{document=**} {
          allow read: if request.auth != null;
          allow write: if false;
        }
      }

      // Violations subcollection: permanent audit records and lecturer reviews
      match /violations/{violationId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
          exists(/databases/$(database)/documents/lecturers/$(request.auth.uid))
        );
        match /{document=**} {
          allow read: if request.auth != null;
          allow write: if false;
        }
      }

      // Audit logs for release and security events
      match /audit_logs/{logId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
          exists(/databases/$(database)/documents/lecturers/$(request.auth.uid))
        );
        match /{document=**} {
          allow read: if request.auth != null;
          allow write: if false;
        }
      }

      // Time adjustments audit records: only Cloud Functions Admin SDK can write
      match /time_adjustments/{adjustmentId} {
        allow read: if request.auth != null;
        allow write: if false;
        match /{document=**} {
          allow read: if request.auth != null;
          allow write: if false;
        }
      }
    }

    // =========================================================================
    // BIOMETRIC SECURITY & HARDWARE CREDENTIALS
    // =========================================================================

    match /biometric_credentials/{docId} {
      // Hardware-backed biometric public keys managed strictly by Cloud Functions
      allow read, write: if false;
      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /biometric_challenges/{docId} {
      // Ephemeral cryptographic nonces managed strictly by Cloud Functions
      allow read, write: if false;
      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /biometric_audit_logs/{docId} {
      // Audit trail of credential enrollments & replacements
      allow read: if request.auth != null && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/lecturers/$(request.auth.uid))
      );
      allow write: if false;
    }

    match /biometric_change_requests/{requestId} {
      // Students can view own requests; staff can view within authorized scope
      allow read: if request.auth != null && (
        resource.data.studentUid == request.auth.uid ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/lecturers/$(request.auth.uid))
      );
      // Students can create pending change requests for themselves
      allow create: if request.auth != null &&
        request.resource.data.studentUid == request.auth.uid &&
        request.resource.data.status == "PENDING";
      // Only authorized staff can update (approve/reject)
      allow update: if request.auth != null && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/lecturers/$(request.auth.uid))
      );
      allow delete: if false;
    }

    match /attendance_records/{recordId} {
      // Read access for authenticated users (students review history, lecturers view class)
      allow read: if request.auth != null;
      // Prohibit client-side creation. Records MUST be created via submitAttendance Cloud Function!
      allow create: if false;
      // Authorized staff may update or clear flagged records
      allow update, delete: if request.auth != null && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/lecturers/$(request.auth.uid))
      );
      match /{document=**} {
        allow read: if request.auth != null;
        allow create: if false;
        allow update, delete: if request.auth != null && (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
          exists(/databases/$(database)/documents/lecturers/$(request.auth.uid))
        );
      }
    }
  }
}
