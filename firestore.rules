rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // CORE AUTHENTICATION & ROLE-BASED ACCESS CONTROL (RBAC) HELPERS
    // Optimized for zero lookup exhaustion (<= 3 document lookups total)
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    // Direct token / superadmin check: 0 Firestore document lookups
    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'onteddukalyani@gmail.com' ||
          request.auth.token.email.split('@')[0].lower() == 'onteddukalyani'
        )) ||
        request.auth.token.admin == true ||
        request.auth.token.role in ['admin', 'superadmin', 'administrator']
      );
    }

    // Admin authorization: max 2 document lookups
    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() && (
          (request.auth.token.email != null && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))) ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        )
      );
    }

    // Lecturer authorization: max 2 document lookups
    function isLecturer() {
      return isSignedIn() && (
        request.auth.token.role in ['lecturer', 'faculty', 'professor'] ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/lecturers/$(request.auth.token.email.lower()))) ||
        exists(/databases/$(database)/documents/lecturers/$(request.auth.uid))
      );
    }

    // Staff authorization (Admin or Lecturer): manages students and academic sessions
    function isStaff() {
      return isAdmin() || isLecturer();
    }

    // =========================================================================
    // STUDENT IDENTITY & BIOMETRIC ANTI-TAMPERING HELPERS
    // =========================================================================

    function isOwnStudentRecord(studentId, data) {
      return isSignedIn() && (
        request.auth.uid == studentId ||
        (data != null && (
          data.studentUid == request.auth.uid ||
          data.uid == request.auth.uid ||
          data.deviceBoundUid == request.auth.uid ||
          (request.auth.token.email != null && data.email != null && data.email.lower() == request.auth.token.email.lower())
        )) ||
        (request.auth.token.email != null && (
          studentId == request.auth.token.email.split('@')[0] ||
          studentId.lower() == request.auth.token.email.split('@')[0].lower() ||
          studentId == request.auth.token.email.split('@')[0].upper() ||
          (data != null && data.rollNo != null && data.rollNo.lower() == request.auth.token.email.split('@')[0].lower())
        ))
      );
    }

    function isOwnUserRecord(userId, data) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        (data != null && (
          data.uid == request.auth.uid ||
          data.studentUid == request.auth.uid ||
          (request.auth.token.email != null && data.email != null && data.email.lower() == request.auth.token.email.lower())
        )) ||
        (request.auth.token.email != null && (
          userId == request.auth.token.email ||
          userId.lower() == request.auth.token.email.lower() ||
          userId.lower() == request.auth.token.email.split('@')[0].lower()
        ))
      );
    }

    // Verifies student is NOT modifying any administrative/privilege fields
    function hasNoStudentPrivilegeEscalation() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'rollNo', 'rollNumber', 'status', 'disqualified', 'academicYear',
        'department', 'branch', 'semester', 'batch', 'role', 'approved',
        'studentUid', 'isAdmin', 'isStaff', 'isLecturer'
      ]);
    }

    // Verifies student is NOT modifying existing enrolled biometrics or device locks
    function hasNoBiometricMutation() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'faceDescriptor', 'faceDescriptors', 'descriptor', 'descriptors',
        'faceVector', 'faceVectors', 'embedding', 'embeddings',
        'faceRegistered', 'biometricEnrolled', 'hasFaceRegistered',
        'faceEnrolledAt', 'faceRemovedAt',
        'hardwareBiometricEnrolled', 'hardwareBiometricPlatform', 'hardwareBiometricEnrolledAt',
        'deviceTypeLocked', 'deviceId', 'registeredPlatform', 'registeredDeviceType'
      ]);
    }

    // Permits initial one-time biometric face enrollment during onboarding
    function isInitialFaceEnrollment() {
      return (
        (!('faceRegistered' in resource.data) || resource.data.faceRegistered != true) &&
        (!('hasFaceRegistered' in resource.data) || resource.data.hasFaceRegistered != true) &&
        request.resource.data.faceRegistered == true &&
        request.resource.data.hasFaceRegistered == true &&
        request.resource.data.faceDescriptor is list &&
        request.resource.data.faceDescriptor.size() == 128
      );
    }

    // Permits re-registration ONLY if staff/admin has authorized it (faceRemovedAt != null)
    function isAuthorizedFaceReRegistration() {
      return (
        resource.data.faceRemovedAt != null &&
        resource.data.faceRegistered != true &&
        request.resource.data.faceRegistered == true &&
        request.resource.data.faceDescriptor is list &&
        request.resource.data.faceDescriptor.size() == 128
      );
    }

    // Permits initial one-time mobile device binding during onboarding
    function isInitialDeviceBinding() {
      return (
        (!('deviceTypeLocked' in resource.data) || resource.data.deviceTypeLocked != true) &&
        request.resource.data.deviceTypeLocked == true
      );
    }

    function isInitialHardwareBiometricEnrollment() {
      return (
        (!('hardwareBiometricEnrolled' in resource.data) || resource.data.hardwareBiometricEnrolled != true) &&
        request.resource.data.hardwareBiometricEnrolled == true
      );
    }

    // Students CANNOT change biometric data after enrollment unless staff authorized
    function studentCanModifyBiometrics() {
      return hasNoBiometricMutation() ||
        isInitialFaceEnrollment() ||
        isAuthorizedFaceReRegistration() ||
        isInitialDeviceBinding() ||
        isInitialHardwareBiometricEnrollment();
    }

    // =========================================================================
    // 1. ADMINS COLLECTION: ONLY Admins can add, remove, or modify admins
    // =========================================================================
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write, delete: if isAdmin();
      }
    }

    // =========================================================================
    // 2. LECTURERS COLLECTION: Managed by ADMIN ONLY for adding and removing.
    // Lecturers CANNOT change other staff details.
    // =========================================================================
    match /lecturers/{lecturerId} {
      allow read: if isSignedIn();
      // Only Admin can add or delete lecturers
      allow create, delete: if isAdmin();
      // Admin can update all; lecturer can ONLY update their own non-privilege profile
      allow update: if isAdmin() || (
        isSignedIn() && (
          request.auth.uid == lecturerId ||
          (request.auth.token.email != null && (
            lecturerId == request.auth.token.email.lower() ||
            lecturerId == request.auth.token.email.split('@')[0].lower() ||
            (resource.data.email != null && resource.data.email.lower() == request.auth.token.email.lower())
          ))
        ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'department', 'designation', 'status', 'approved', 'isAdmin'
        ])
      );
      match /{document=**} {
        allow read: if isSignedIn();
        allow write, delete: if isAdmin();
      }
    }

    // =========================================================================
    // 3. STUDENTS COLLECTION: Managed by BOTH Admin and Lecturer.
    // Students CANNOT do anything administrative and CANNOT change their biometrics.
    // =========================================================================
    match /students/{studentId} {
      // Staff can read all; student can ONLY read their own record
      allow get: if isStaff() || isOwnStudentRecord(studentId, resource.data);
      allow list: if isStaff();

      // Staff can create any student; new student can create initial registration profile
      allow create: if isStaff() || (
        isSignedIn() &&
        (request.auth.uid == studentId || (request.auth.token.email != null && request.resource.data.email != null && request.resource.data.email.lower() == request.auth.token.email.lower())) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'student') &&
        (!('status' in request.resource.data) || request.resource.data.status in ['active', 'pending']) &&
        !request.resource.data.keys().hasAny(['disqualified', 'isAdmin', 'isStaff', 'isLecturer'])
      );

      // Staff can update any student; student can update own profile with strict anti-tampering
      allow update: if isStaff() || (
        isSignedIn() &&
        isOwnStudentRecord(studentId, resource.data) &&
        hasNoStudentPrivilegeEscalation() &&
        studentCanModifyBiometrics()
      );

      // ONLY Staff can delete student records (students CANNOT delete)
      allow delete: if isStaff();

      match /{document=**} {
        allow read, write, delete: if isStaff();
      }
    }

    // =========================================================================
    // 4. USERS AUTH INDEX
    // =========================================================================
    match /users/{userId} {
      allow get: if isStaff() || isOwnUserRecord(userId, resource.data);
      allow list: if isStaff();
      allow create: if isStaff() || (
        isSignedIn() &&
        isOwnUserRecord(userId, request.resource.data) &&
        !request.resource.data.keys().hasAny(['role', 'isAdmin', 'isStaff', 'isLecturer', 'status'])
      );
      allow update: if isAdmin() || (
        isStaff() && (!('role' in resource.data) || resource.data.role == 'student')
      ) || (
        isSignedIn() &&
        isOwnUserRecord(userId, resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'isStaff', 'isLecturer', 'status'])
      );
      allow delete: if isAdmin();
      match /{document=**} {
        allow read: if isStaff();
        allow write, delete: if isAdmin();
      }
    }

    match /authorizedUsers/{userId} {
      allow read: if isStaff();
      allow write, delete: if isAdmin();
      match /{document=**} {
        allow read: if isStaff();
        allow write, delete: if isAdmin();
      }
    }

    // =========================================================================
    // 5. NOTIFICATIONS PRIVACY: NO ONE CAN READ OTHERS' NOTIFICATIONS
    // =========================================================================

    // Student Notifications: private to the specific recipient student
    match /student_notifications/{studentRollNo} {
      // Staff can read all; student can ONLY read their own notifications
      allow read: if isStaff() || (
        isSignedIn() && request.auth.token.email != null && (
          studentRollNo.lower() == request.auth.token.email.split('@')[0].lower() ||
          (resource.data != null && (
            (resource.data.rollNo != null && resource.data.rollNo.lower() == request.auth.token.email.split('@')[0].lower()) ||
            (resource.data.email != null && resource.data.email.lower() == request.auth.token.email.lower()) ||
            (resource.data.recipient != null && resource.data.recipient.lower() == request.auth.token.email.split('@')[0].lower())
          ))
        )
      ) || (isSignedIn() && (request.auth.uid == studentRollNo || (resource.data != null && resource.data.studentUid == request.auth.uid)));

      allow write: if isStaff() || isSignedIn();
      allow delete: if isStaff() || (
        isSignedIn() && request.auth.token.email != null && (
          studentRollNo.lower() == request.auth.token.email.split('@')[0].lower()
        )
      );

      match /{document=**} {
        allow read, write, delete: if isStaff();
      }
    }

    // Admin Notifications: ONLY Admins can read
    match /admin_notifications/{notificationId} {
      allow read, update, delete: if isAdmin();
      allow create: if isSignedIn();
      match /{document=**} {
        allow read, write, delete: if isAdmin();
      }
    }

    // Lecturer & Faculty Notifications: ONLY Staff can read; students CANNOT read
    match /lecturer_notifications/{notificationId} {
      allow read: if isAdmin() || (
        isLecturer() && (
          resource.data == null ||
          resource.data.recipientRole in ['lecturer', 'faculty'] ||
          (request.auth.token.email != null && (
            (resource.data.recipient != null && resource.data.recipient.lower() == request.auth.token.email.lower()) ||
            (resource.data.lecturerEmail != null && resource.data.lecturerEmail.lower() == request.auth.token.email.lower())
          ))
        )
      );
      allow create: if isStaff();
      allow update, delete: if isAdmin() || (isLecturer() && resource.data != null && resource.data.lecturerEmail == request.auth.token.email);
      match /{document=**} {
        allow read, write, delete: if isStaff();
      }
    }

    match /faculty_notifications/{notificationId} {
      allow read, write, delete: if isStaff();
      match /{document=**} {
        allow read, write, delete: if isStaff();
      }
    }

    // Public / Shared institutional announcements
    match /broadcast_notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write, delete: if isStaff();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write, delete: if isStaff();
      }
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write, delete: if isStaff();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write, delete: if isStaff();
      }
    }

    match /broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write, delete: if isStaff();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write, delete: if isStaff();
      }
    }

    match /notifications/{notificationId} {
      allow read: if isStaff() || (
        isSignedIn() && resource.data != null && (
          resource.data.userId == request.auth.uid ||
          (request.auth.token.email != null && resource.data.recipient == request.auth.token.email)
        )
      );
      allow write, delete: if isStaff();
      match /{document=**} {
        allow read, write, delete: if isStaff();
      }
    }

    // Recursive collectionGroup for notifications (Database Hub cleanup)
    match /{path=**}/notifications/{notificationId} {
      allow read, write, delete: if isStaff();
    }

    // User Complaints, Support Tickets & Feedbacks: Private to author and staff
    match /support_tickets/{ticketId} {
      allow read: if isStaff() || (isSignedIn() && resource.data != null && (
        resource.data.userId == request.auth.uid ||
        (request.auth.token.email != null && resource.data.email != null && resource.data.email.lower() == request.auth.token.email.lower())
      ));
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
      match /{document=**} {
        allow read, write, delete: if isStaff();
      }
    }

    match /user_complaints/{complaintId} {
      allow read: if isStaff() || (isSignedIn() && resource.data != null && (
        resource.data.userId == request.auth.uid ||
        (request.auth.token.email != null && resource.data.email != null && resource.data.email.lower() == request.auth.token.email.lower())
      ));
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
      match /{document=**} {
        allow read, write, delete: if isStaff();
      }
    }

    match /security_complaints/{complaintId} {
      allow read: if isStaff() || (isSignedIn() && resource.data != null && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
      match /{document=**} {
        allow read, write, delete: if isStaff();
      }
    }

    match /feedbacks/{feedbackId} {
      allow read: if isStaff();
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
      match /{document=**} {
        allow read, write, delete: if isStaff();
      }
    }

    // =========================================================================
    // 6. COURSES & ATTENDANCE SESSIONS (Managed by Staff)
    // =========================================================================
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write, delete: if isStaff();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write, delete: if isStaff();
      }
    }

    match /pre_session_anchors/{anchorId} {
      allow read, write, delete: if true;
    }

    match /attendance_sessions/{sessionId} {
      allow read: if isSignedIn();
      allow write, delete: if isStaff();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write, delete: if isStaff();
      }
    }

    match /attendance_records/{recordId} {
      // Staff can read all logs; student can ONLY read their own attendance records
      allow read: if isStaff() || (
        isSignedIn() && resource.data != null && (
          resource.data.uid == request.auth.uid ||
          resource.data.studentUid == request.auth.uid ||
          (request.auth.token.email != null && (
            (resource.data.studentRoll != null && resource.data.studentRoll.lower() == request.auth.token.email.split('@')[0].lower()) ||
            (resource.data.rollNo != null && resource.data.rollNo.lower() == request.auth.token.email.split('@')[0].lower()) ||
            (resource.data.email != null && resource.data.email.lower() == request.auth.token.email.lower())
          ))
        )
      );
      // Student can submit their own attendance during session; staff can mark attendance
      allow create: if isStaff() || (
        isSignedIn() && (
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.studentUid == request.auth.uid ||
          (request.auth.token.email != null && (
            (request.resource.data.studentRoll != null && request.resource.data.studentRoll.lower() == request.auth.token.email.split('@')[0].lower()) ||
            (request.resource.data.rollNo != null && request.resource.data.rollNo.lower() == request.auth.token.email.split('@')[0].lower()) ||
            (request.resource.data.email != null && request.resource.data.email.lower() == request.auth.token.email.lower())
          ))
        )
      );
      allow update, delete: if isStaff();
      match /{document=**} {
        allow read, write, delete: if isStaff();
      }
    }

    // =========================================================================
    // 7. BIOMETRICS, DEVICES & HARDWARE SECURITY
    // =========================================================================

    // Student can register device during onboarding; staff manages device locks
    match /devices/{deviceId} {
      allow read: if isStaff() || (
        isSignedIn() && resource.data != null && (
          resource.data.uid == request.auth.uid ||
          resource.data.studentUid == request.auth.uid ||
          (request.auth.token.email != null && resource.data.rollNo != null && resource.data.rollNo.lower() == request.auth.token.email.split('@')[0].lower())
        )
      );
      // Initial device binding allowed for student
      allow create: if isSignedIn() && (
        request.resource.data.uid == request.auth.uid ||
        request.resource.data.studentUid == request.auth.uid ||
        isStaff()
      );
      // Only Staff can unlock or delete device bindings (students cannot unlock own device)
      allow update, delete: if isStaff();
      match /{document=**} {
        allow read, write, delete: if isStaff();
      }
    }

    match /biometric_credentials/{docId} {
      allow read: if isStaff() || (isSignedIn() && (docId == request.auth.uid || resource.data.studentUid == request.auth.uid));
      // First-time enrollment or staff creation; students CANNOT overwrite existing credentials
      allow create: if isStaff() || (
        isSignedIn() && (docId == request.auth.uid || request.resource.data.studentUid == request.auth.uid)
      );
      // Students CANNOT modify or delete credentials once registered
      allow update, delete: if isStaff();
      match /{document=**} {
        allow read, write, delete: if isStaff();
      }
    }

    match /biometric_reregistration_permissions/{permId} {
      allow read: if isSignedIn();
      allow write, delete: if isStaff();
      match /{document=**} {
        allow read, write, delete: if isStaff();
      }
    }

    match /reregistration_requests/{requestId} {
      allow read: if isStaff() || (isSignedIn() && resource.data != null && resource.data.studentUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.studentUid == request.auth.uid;
      allow update, delete: if isStaff();
      match /{document=**} {
        allow read, write, delete: if isStaff();
      }
    }

    match /biometric_challenges/{docId} {
      allow read, write, delete: if isSignedIn();
      match /{document=**} {
        allow read, write, delete: if isSignedIn();
      }
    }

    match /face_enrollments/{studentId} {
      allow read, write, delete: if isStaff();
      match /{document=**} {
        allow read, write, delete: if isStaff();
      }
    }

    match /face_enrollment_control/{guardId} {
      allow read, write, delete: if isStaff();
      match /{document=**} {
        allow read, write, delete: if isStaff();
      }
    }

    match /face_enrollment_reviews/{reviewId} {
      allow read: if isStaff() || (isSignedIn() && resource.data != null && resource.data.studentUid == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
      match /{document=**} {
        allow read, write, delete: if isStaff();
      }
    }

    // =========================================================================
    // 8. SYSTEM, RECOVERY & INSTITUTION SETTINGS (Admin ONLY)
    // =========================================================================
    match /institution_settings/{docId} {
      allow read: if isSignedIn();
      allow write, delete: if isAdmin();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write, delete: if isAdmin();
      }
    }

    match /institution/{docId} {
      allow read: if isSignedIn();
      allow write, delete: if isAdmin();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write, delete: if isAdmin();
      }
    }

    match /app_updates/{docId} {
      allow read: if true;
      allow write, delete: if isAdmin();
      match /{document=**} {
        allow read: if true;
        allow write, delete: if isAdmin();
      }
    }

    match /database_recovery/{recoveryId} {
      allow read, write, delete: if isAdmin();
      match /{document=**} {
        allow read, write, delete: if isAdmin();
      }
    }

    match /audit_logs/{logId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /time_adjustments/{adjustmentId} {
      allow read, write: if isStaff();
    }

    match /geofence_adjustments/{adjustmentId} {
      allow read, write: if isStaff();
    }
  }
}
