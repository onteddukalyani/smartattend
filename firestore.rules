rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read, write: if isAuthenticated();
    }

    // Lecturers Collection
    match /lecturers/{lecturerId} {
      allow read, write: if isAuthenticated();
    }

    // Students Collection - Read & write accessible for lookups, attendance, and biometric enrollment
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Authorized Users Collection (Roster / Whitelist & Google Auth Sync)
    match /authorizedUsers/{userId} {
      allow read, write: if true;
    }

    // Users Collection (Universal User Profiles)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Attendance Sessions
    match /attendance_sessions/{sessionId} {
      allow read, write: if true;
    }

    // Attendance Records
    match /attendance_records/{recordId} {
      allow read, write: if true;
    }

    // Courses Collection
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Institution Settings
    match /institution_settings/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}


