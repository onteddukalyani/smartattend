rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && (
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) ||
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) ||
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email.split('@')[0])) ||
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email.split('@')[0].lower()))
        ))
      );
    }

    function isLecturer() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/lecturers/$(request.auth.uid)) ||
        (request.auth.token.email != null && (
          exists(/databases/$(database)/documents/lecturers/$(request.auth.token.email)) ||
          exists(/databases/$(database)/documents/lecturers/$(request.auth.token.email.lower())) ||
          exists(/databases/$(database)/documents/lecturers/$(request.auth.token.email.split('@')[0])) ||
          exists(/databases/$(database)/documents/lecturers/$(request.auth.token.email.split('@')[0].lower()))
        ))
      );
    }

    function isStaff() {
      return isAdmin() || isLecturer();
    }

    // Admins collection: strictly protected against client tampering and privilege escalation
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() && (
          request.auth.uid == adminId ||
          (request.auth.token.email != null && (
            adminId == request.auth.token.email ||
            adminId == request.auth.token.email.split('@')[0] ||
            (resource.data.email != null && resource.data.email.lower() == request.auth.token.email.lower())
          ))
        ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'approved', 'isAdmin'])
      );
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    match /institution_settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    match /institution/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    match /app_updates/{docId} {
      allow read: if true;
      allow write: if isAdmin();
      match /{document=**} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Lecturers collection: managed by admins; lecturers can update own device and profile settings
    match /lecturers/{lecturerId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() && (
          request.auth.uid == lecturerId ||
          (request.auth.token.email != null && (
            lecturerId == request.auth.token.email ||
            lecturerId == request.auth.token.email.split('@')[0] ||
            (resource.data.email != null && resource.data.email.lower() == request.auth.token.email.lower())
          ))
        ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'department', 'designation', 'status', 'approved'])
      );
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    // Courses collection: managed by admins and authorized lecturers
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }
    }

    // Students collection: records managed by staff.
    // Students can update their own profile, faceDescriptor, and biometric hardware keys, but cannot alter rollNo, status, role, or device lock.
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow create: if isStaff() || (
        isSignedIn() &&
        (
          request.auth.uid == studentId ||
          (request.resource.data.studentUid != null && request.resource.data.studentUid == request.auth.uid) ||
          (request.auth.token.email != null && request.resource.data.email != null && (request.resource.data.email == request.auth.token.email || request.resource.data.email.lower() == request.auth.token.email.lower()))
        ) &&
        !request.resource.data.keys().hasAny(['status', 'disqualified', 'role'])
      );
      allow delete: if isStaff();
      allow update: if isStaff() || (
        isSignedIn() &&
        (
          request.auth.uid == studentId ||
          (resource.data.studentUid != null && resource.data.studentUid == request.auth.uid) ||
          (request.auth.token.email != null && resource.data.email != null && (resource.data.email == request.auth.token.email || resource.data.email.lower() == request.auth.token.email.lower())) ||
          (request.auth.token.email != null && request.auth.token.email.split('@')[0].lower() == studentId.lower()) ||
          (resource.data.rollNo != null && request.auth.token.email != null && resource.data.rollNo.lower() == request.auth.token.email.split('@')[0].lower()) ||
          (!('studentUid' in resource.data) || resource.data.studentUid == null || resource.data.studentUid == "")
        ) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'rollNo', 'rollNumber', 'status', 'disqualified', 'academicYear', 'department', 'batch', 'role'
        ]) &&
        // Prevent unlocking an already locked device from client side
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deviceTypeLocked']) ||
          (resource.data.deviceTypeLocked != true && request.resource.data.deviceTypeLocked == true)
        )
      );
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }
    }

    // Users collection: users can create/update own profile
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        isAdmin() || (
          (
            request.auth.uid == userId ||
            (request.resource.data.studentUid != null && request.resource.data.studentUid == request.auth.uid)
          ) &&
          !request.resource.data.keys().hasAny([
            'role', 'isAdmin', 'isLecturer', 'status', 'disqualified', 'department', 'batch'
          ])
        )
      );
      allow update: if isSignedIn() && (
        isAdmin() || (
          (
            request.auth.uid == userId ||
            (resource.data.studentUid != null && resource.data.studentUid == request.auth.uid) ||
            (request.auth.token.email != null && resource.data.email != null && (resource.data.email == request.auth.token.email || resource.data.email.lower() == request.auth.token.email.lower())) ||
            (request.auth.token.email != null && userId.lower() == request.auth.token.email.split('@')[0].lower())
          ) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'isAdmin', 'isLecturer', 'status', 'disqualified', 'department', 'batch'
          ]) &&
          (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
        )
      );
      allow delete: if isAdmin();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    match /authorizedUsers/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    // Notifications & Communications
    match /faculty_notifications/{notificationId} {
      allow read: if isStaff();
      allow write: if isStaff();
      match /{document=**} {
        allow read, write: if isStaff();
      }
    }

    match /admin_notifications/{notificationId} {
      allow read, write: if isAdmin();
      match /{document=**} {
        allow read, write: if isAdmin();
      }
    }

    match /lecturer_notifications/{notificationId} {
      allow read, write: if isStaff();
      match /{document=**} {
        allow read, write: if isStaff();
      }
    }

    match /broadcast_notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }
    }

    match /broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }
    }

    match /user_complaints/{complaintId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
      match /{document=**} {
        allow read: if isStaff();
        allow write: if isStaff();
      }
    }

    match /support_tickets/{ticketId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
      match /{document=**} {
        allow read: if isStaff();
        allow write: if isStaff();
      }
    }

    match /feedbacks/{feedbackId} {
      allow read: if isStaff();
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
      match /{document=**} {
        allow read: if isStaff();
        allow write: if isStaff();
      }
    }

    match /security_complaints/{complaintId} {
      allow read: if isStaff();
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
      match /{document=**} {
        allow read: if isStaff();
        allow write: if isStaff();
      }
    }

    match /student_notifications/{studentRollNo} {
      allow read: if isSignedIn();
      allow write: if isStaff();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }
    }

    // =========================================================================
    // ATTENDANCE SESSIONS & SECURITY TOKENS
    // =========================================================================

    match /attendance_sessions/{sessionId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && isStaff();

      allow delete: if isSignedIn() && (
        isAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.ownerEmail == request.auth.token.email
      );

      allow update: if isSignedIn() && (
        isAdmin() ||
        (isLecturer() && (resource.data.ownerId == request.auth.uid || (request.auth.token.email != null && resource.data.ownerEmail == request.auth.token.email)))
      );

      match /security/{docId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          (isLecturer() && exists(/databases/$(database)/documents/attendance_sessions/$(sessionId)) && (
            get(/databases/$(database)/documents/attendance_sessions/$(sessionId)).data.ownerId == request.auth.uid ||
            (request.auth.token.email != null && get(/databases/$(database)/documents/attendance_sessions/$(sessionId)).data.ownerEmail == request.auth.token.email)
          ))
        );
        allow write: if isSignedIn() && (
          isAdmin() ||
          (isLecturer() && exists(/databases/$(database)/documents/attendance_sessions/$(sessionId)) && (
            get(/databases/$(database)/documents/attendance_sessions/$(sessionId)).data.ownerId == request.auth.uid ||
            (request.auth.token.email != null && get(/databases/$(database)/documents/attendance_sessions/$(sessionId)).data.ownerEmail == request.auth.token.email)
          ))
        );
        match /{document=**} {
          allow read: if isSignedIn() && (
            isAdmin() ||
            (isLecturer() && exists(/databases/$(database)/documents/attendance_sessions/$(sessionId)) && (
              get(/databases/$(database)/documents/attendance_sessions/$(sessionId)).data.ownerId == request.auth.uid ||
              (request.auth.token.email != null && get(/databases/$(database)/documents/attendance_sessions/$(sessionId)).data.ownerEmail == request.auth.token.email)
            ))
          );
          allow write: if false;
        }
      }

      // Authorizations subcollection: student devices and lecturers
      // Students can only update heartbeat/telemetry fields. Cannot alter status, violations, kiosk timers, or QR gating.
      match /authorizations/{authDocId} {
        allow read: if isSignedIn();
        allow create, delete: if isStaff();
        allow update: if isStaff() || (
          isSignedIn() &&
          (request.auth.uid == authDocId || (resource.data.studentUid != null && resource.data.studentUid == request.auth.uid)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastHeartbeat', 'clientTimestamp', 'detectedPlatform', 'deviceIp', 'userAgent', 'studentLocation'
          ]) &&
          (resource.data.hasViolation != true || request.resource.data.hasViolation == true) &&
          (resource.data.disqualified != true || request.resource.data.disqualified == true)
        );
        match /{document=**} {
          allow read: if isSignedIn();
          allow write: if false;
        }
      }

      match /violations/{violationId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isStaff();
        match /{document=**} {
          allow read: if isSignedIn();
          allow write: if false;
        }
      }

      match /audit_logs/{logId} {
        allow read: if isSignedIn();
        allow write: if isStaff();
        match /{document=**} {
          allow read: if isSignedIn();
          allow write: if false;
        }
      }

      // Time adjustments audit records: only Cloud Functions Admin SDK can write
      match /time_adjustments/{adjustmentId} {
        allow read: if isSignedIn();
        allow write: if false;
        match /{document=**} {
          allow read: if isSignedIn();
          allow write: if false;
        }
      }

      // Geofence adjustments audit records: only Cloud Functions Admin SDK can write
      match /geofence_adjustments/{adjustmentId} {
        allow read: if isSignedIn();
        allow write: if false;
        match /{document=**} {
          allow read: if isSignedIn();
          allow write: if false;
        }
      }
    }

    // =========================================================================
    // BIOMETRIC SECURITY & HARDWARE CREDENTIALS
    // =========================================================================

    match /biometric_credentials/{docId} {
      allow read: if isStaff() || (isSignedIn() && (docId == request.auth.uid || resource.data.studentUid == request.auth.uid));
      allow write: if isStaff();
      match /{document=**} {
        allow read: if isStaff() || (isSignedIn() && (docId == request.auth.uid || resource.data.studentUid == request.auth.uid));
        allow write: if isStaff();
      }
    }

    match /biometric_challenges/{docId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.studentUid == request.auth.uid);
      allow write: if false;
      match /{document=**} {
        allow read: if isStaff() || (isSignedIn() && resource.data.studentUid == request.auth.uid);
        allow write: if false;
      }
    }

    match /biometric_audit_logs/{docId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /biometric_change_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.studentUid == request.auth.uid || isStaff()
      );
      allow create: if isSignedIn() &&
        request.resource.data.studentUid == request.auth.uid &&
        request.resource.data.status == "PENDING";
      allow update: if isStaff();
      allow delete: if false;
    }

    match /attendance_records/{recordId} {
      allow read: if isStaff() || (isSignedIn() && (resource.data.studentUid == request.auth.uid || resource.data.studentEmail == request.auth.token.email));
      allow create: if isStaff();
      allow update, delete: if isStaff();
      match /{document=**} {
        allow read: if isStaff() || (isSignedIn() && (resource.data.studentUid == request.auth.uid || resource.data.studentEmail == request.auth.token.email));
        allow write: if isStaff();
      }
    }
  }
}
