rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/admins/$(request.auth.token.email)))
      );
    }

    function isLecturer() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/lecturers/$(request.auth.uid)) ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/lecturers/$(request.auth.token.email)))
      );
    }

    function isStaff() {
      return isAdmin() || isLecturer();
    }

    // Admins collection: strictly protected against client tampering and privilege escalation
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    match /institution_settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    match /institution/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    match /app_updates/{docId} {
      allow read: if true;
      allow write: if isAdmin();
      match /{document=**} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Lecturers collection: only admins can create, update, or delete lecturer accounts
    match /lecturers/{lecturerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    // Courses collection: managed by admins and authorized lecturers
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }
    }

    // Students collection: records managed by staff.
    // Students can update their own personal non-academic details, but cannot alter rollNo, status, or biometrics.
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow create, delete: if isStaff();
      allow update: if isStaff() || (
        isSignedIn() &&
        (request.auth.uid == studentId || (resource.data.studentUid != null && resource.data.studentUid == request.auth.uid)) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'rollNo', 'rollNumber', 'faceDescriptor', 'biometricEnrolled',
          'hardwareBiometricPlatform', 'status', 'disqualified', 'academicYear', 'department', 'batch'
        ])
      );
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }
    }

    // Users collection: users can create/update own profile; non-admins cannot escalate role
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
      allow update: if isSignedIn() && (
        isAdmin() || (
          request.auth.uid == userId &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'isLecturer']) ||
           request.resource.data.role == resource.data.role)
        )
      );
      allow delete: if isAdmin();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    match /authorizedUsers/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    // Notifications & Communications
    match /faculty_notifications/{notificationId} {
      allow read: if isStaff();
      allow write: if isStaff();
      match /{document=**} {
        allow read, write: if isStaff();
      }
    }

    match /admin_notifications/{notificationId} {
      allow read, write: if isAdmin();
      match /{document=**} {
        allow read, write: if isAdmin();
      }
    }

    match /lecturer_notifications/{notificationId} {
      allow read, write: if isStaff();
      match /{document=**} {
        allow read, write: if isStaff();
      }
    }

    match /broadcast_notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }
    }

    match /broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }
    }

    match /user_complaints/{complaintId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
      match /{document=**} {
        allow read: if isStaff();
        allow write: if isStaff();
      }
    }

    match /support_tickets/{ticketId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
      match /{document=**} {
        allow read: if isStaff();
        allow write: if isStaff();
      }
    }

    match /feedbacks/{feedbackId} {
      allow read: if isStaff();
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
      match /{document=**} {
        allow read: if isStaff();
        allow write: if isStaff();
      }
    }

    match /security_complaints/{complaintId} {
      allow read: if isStaff();
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
      match /{document=**} {
        allow read: if isStaff();
        allow write: if isStaff();
      }
    }

    match /student_notifications/{studentRollNo} {
      allow read: if isSignedIn();
      allow write: if isStaff();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }
    }

    // =========================================================================
    // ATTENDANCE SESSIONS & SECURITY TOKENS
    // =========================================================================

    match /attendance_sessions/{sessionId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && (
        isStaff() ||
        request.resource.data.ownerId == request.auth.uid ||
        (request.auth.token.email != null && request.resource.data.ownerEmail == request.auth.token.email)
      );

      allow delete: if isSignedIn() && (
        isAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.ownerEmail == request.auth.token.email
      );

      allow update: if isSignedIn() && (
        isAdmin() ||
        isLecturer() ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.ownerEmail == request.auth.token.email ||
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'ownerId', 'ownerEmail', 'createdBy', 'lecturerName', 'lecturerEmail',
            'kioskEndsAt', 'expiresAt', 'qr1ExpiresAt', 'qr2StartsAt', 'sessionStartAt', 'startedAt', 'createdAt',
            'qr1DurationSeconds', 'qr2DurationSeconds', 'totalDurationSeconds', 'durationMinutes',
            'active', 'status', 'phase', 'kioskModeEnabled', 'strictKiosk',
            'qr1Token', 'qr2Token', 'qr1TokenHash', 'qr2TokenHash',
            'sessionPin', 'releaseCode', 'lecturerPin', 'lecturerReleaseCode',
            'sessionPinHash', 'lecturerPinHash', 'lecturerReleaseCodeHash', 'security',
            'courseId', 'courseCode', 'classCode', 'batch', 'department', 'semester',
            'geofence', 'geofenceRadius', 'classroomLocation', 'geofenceEnabled', 'location'
          ])
        )
      );

      match /security/{docId} {
        allow read: if isSignedIn() && (
          isStaff() ||
          (exists(/databases/$(database)/documents/attendance_sessions/$(sessionId)) && (
            get(/databases/$(database)/documents/attendance_sessions/$(sessionId)).data.ownerId == request.auth.uid ||
            (request.auth.token.email != null && get(/databases/$(database)/documents/attendance_sessions/$(sessionId)).data.ownerEmail == request.auth.token.email)
          ))
        );
        allow write: if isSignedIn() && (
          isStaff() ||
          (request.resource != null && request.resource.data.ownerId == request.auth.uid) ||
          (resource != null && resource.data.ownerId == request.auth.uid) ||
          (exists(/databases/$(database)/documents/attendance_sessions/$(sessionId)) && (
            get(/databases/$(database)/documents/attendance_sessions/$(sessionId)).data.ownerId == request.auth.uid ||
            (request.auth.token.email != null && get(/databases/$(database)/documents/attendance_sessions/$(sessionId)).data.ownerEmail == request.auth.token.email)
          ))
        );
        match /{document=**} {
          allow read, write: if isSignedIn() && isStaff();
        }
      }

      // Authorizations subcollection: student devices and lecturers
      // Students CANNOT set qr1Verified: true, status: "ATTENDED", or reset/delete hasViolation or disqualified
      match /authorizations/{authDocId} {
        allow read: if isSignedIn();
        allow create, delete: if isStaff();
        allow update: if isStaff() || (
          isSignedIn() &&
          (request.auth.uid == authDocId || (resource.data.studentUid != null && resource.data.studentUid == request.auth.uid)) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'qr1Verified', 'excused', 'excusedBy', 'excuseReason', 'kioskEndsAt'
          ]) &&
          (resource.data.hasViolation != true || request.resource.data.hasViolation == true) &&
          (resource.data.disqualified != true || request.resource.data.disqualified == true)
        );
        match /{document=**} {
          allow read: if isSignedIn();
          allow write: if false;
        }
      }

      match /violations/{violationId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isStaff();
        match /{document=**} {
          allow read: if isSignedIn();
          allow write: if false;
        }
      }

      match /audit_logs/{logId} {
        allow read: if isSignedIn();
        allow write: if isStaff();
        match /{document=**} {
          allow read: if isSignedIn();
          allow write: if false;
        }
      }

      // Time adjustments audit records: only Cloud Functions Admin SDK can write
      match /time_adjustments/{adjustmentId} {
        allow read: if isSignedIn();
        allow write: if false;
        match /{document=**} {
          allow read: if isSignedIn();
          allow write: if false;
        }
      }

      // Geofence adjustments audit records: only Cloud Functions Admin SDK can write
      match /geofence_adjustments/{adjustmentId} {
        allow read: if isSignedIn();
        allow write: if false;
        match /{document=**} {
          allow read: if isSignedIn();
          allow write: if false;
        }
      }
    }

    // =========================================================================
    // BIOMETRIC SECURITY & HARDWARE CREDENTIALS
    // =========================================================================

    match /biometric_credentials/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == docId || isStaff());
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }
    }

    match /biometric_challenges/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
      match /{document=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /biometric_audit_logs/{docId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /biometric_change_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.studentUid == request.auth.uid || isStaff()
      );
      allow create: if isSignedIn() &&
        request.resource.data.studentUid == request.auth.uid &&
        request.resource.data.status == "PENDING";
      allow update: if isStaff();
      allow delete: if false;
    }

    match /attendance_records/{recordId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        isStaff() ||
        request.auth.uid == request.resource.data.studentUid ||
        request.resource.data.rollNo != null
      );
      allow update, delete: if isStaff();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }
    }
  }
}
