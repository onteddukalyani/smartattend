rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'onteddukalyani@gmail.com' ||
          request.auth.token.email.split('@')[0].lower() == 'onteddukalyani'
        )) ||
        request.auth.token.admin == true ||
        request.auth.token.role in ['admin', 'superadmin', 'administrator'] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin', 'administrator'] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        )) ||
        (request.auth.token.email != null && (
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) ||
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) ||
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email.split('@')[0])) ||
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email.split('@')[0].lower())) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.token.email.lower())) && (
            get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data.role in ['admin', 'superadmin', 'administrator'] ||
            get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data.isAdmin == true
          )) ||
          (exists(/databases/$(database)/documents/authorizedUsers/$(request.auth.token.email.lower())) && (
            get(/databases/$(database)/documents/authorizedUsers/$(request.auth.token.email.lower())).data.role in ['admin', 'superadmin', 'administrator'] ||
            get(/databases/$(database)/documents/authorizedUsers/$(request.auth.token.email.lower())).data.isAdmin == true
          ))
        ))
      );
    }

    function isLecturer() {
      return isSignedIn() && (
        request.auth.token.role in ['lecturer', 'faculty', 'professor'] ||
        exists(/databases/$(database)/documents/lecturers/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['lecturer', 'faculty', 'professor']
        )) ||
        (request.auth.token.email != null && (
          exists(/databases/$(database)/documents/lecturers/$(request.auth.token.email)) ||
          exists(/databases/$(database)/documents/lecturers/$(request.auth.token.email.lower())) ||
          exists(/databases/$(database)/documents/lecturers/$(request.auth.token.email.split('@')[0])) ||
          exists(/databases/$(database)/documents/lecturers/$(request.auth.token.email.split('@')[0].lower())) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.token.email.lower())) && (
            get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data.role in ['lecturer', 'faculty', 'professor']
          )) ||
          (exists(/databases/$(database)/documents/authorizedUsers/$(request.auth.token.email.lower())) && (
            get(/databases/$(database)/documents/authorizedUsers/$(request.auth.token.email.lower())).data.role in ['lecturer', 'faculty', 'professor']
          )) ||
          (exists(/databases/$(database)/documents/authorizedUsers/$(request.auth.token.email.split('@')[0].lower())) && (
            get(/databases/$(database)/documents/authorizedUsers/$(request.auth.token.email.split('@')[0].lower())).data.role in ['lecturer', 'faculty', 'professor']
          ))
        ))
      );
    }

    function isStaff() {
      return isAdmin() || isLecturer();
    }

    function hasNoFaceTemplate(data) {
      return !data.keys().hasAny([
        'faceDescriptor', 'faceDescriptors', 'descriptor', 'descriptors',
        'faceVector', 'faceVectors', 'embedding', 'embeddings'
      ]);
    }

    function hasNoClientFaceEnrollmentMutation() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'faceDescriptor', 'faceDescriptors', 'descriptor', 'descriptors',
        'faceVector', 'faceVectors', 'embedding', 'embeddings',
        'faceRegistered', 'biometricEnrolled', 'hasFaceRegistered',
        'faceEnrolledAt', 'faceRemovedAt',
        'hardwareBiometricEnrolled', 'hardwareBiometricPlatform', 'hardwareBiometricEnrolledAt',
        'isDeviceRegistered', 'registeredPlatform', 'registeredDeviceType'
      ]);
    }

    function isInitialFaceEnrollment() {
      return (
        (!('faceRegistered' in resource.data) || resource.data.faceRegistered != true) &&
        (!('hasFaceRegistered' in resource.data) || resource.data.hasFaceRegistered != true) &&
        request.resource.data.faceRegistered == true &&
        request.resource.data.hasFaceRegistered == true &&
        request.resource.data.faceDescriptor is list &&
        request.resource.data.faceDescriptor.size() == 128
      );
    }

    function isAuthorizedFaceReRegistration() {
      return (
        resource.data.faceRemovedAt != null &&
        resource.data.faceRegistered != true &&
        request.resource.data.faceRegistered == true &&
        request.resource.data.faceDescriptor is list &&
        request.resource.data.faceDescriptor.size() == 128
      );
    }

    function isInitialDeviceBinding() {
      return (
        (!('deviceTypeLocked' in resource.data) || resource.data.deviceTypeLocked != true) &&
        request.resource.data.deviceTypeLocked == true
      );
    }

    function isInitialHardwareBiometricEnrollment() {
      return (
        (!('hardwareBiometricEnrolled' in resource.data) || resource.data.hardwareBiometricEnrolled != true) &&
        request.resource.data.hardwareBiometricEnrolled == true
      );
    }

    function canEnrollOrModifyBiometrics() {
      return hasNoClientFaceEnrollmentMutation() ||
        isInitialFaceEnrollment() ||
        isAuthorizedFaceReRegistration() ||
        isInitialDeviceBinding() ||
        isInitialHardwareBiometricEnrollment();
    }

    function isOwnStudentRecord(studentId, data) {
      return isSignedIn() && (
        request.auth.uid == studentId ||
        data.studentUid == request.auth.uid ||
        data.uid == request.auth.uid ||
        (request.auth.token.email != null && (
          data.email == request.auth.token.email ||
          (data.email != null && data.email.lower() == request.auth.token.email.lower()) ||
          studentId == request.auth.token.email.split('@')[0] ||
          studentId.lower() == request.auth.token.email.split('@')[0].lower()
        ))
      );
    }

    function isOwnUserRecord(userId, data) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        data.studentUid == request.auth.uid ||
        data.uid == request.auth.uid ||
        (request.auth.token.email != null && (
          data.email == request.auth.token.email ||
          (data.email != null && data.email.lower() == request.auth.token.email.lower()) ||
          (userId.lower() == request.auth.token.email.split('@')[0].lower() &&
            (!('studentUid' in data) || data.studentUid == null || data.studentUid == request.auth.uid))
        ))
      );
    }

    // Admins collection: strictly protected against client tampering and privilege escalation
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() && (
          request.auth.uid == adminId ||
          (request.auth.token.email != null && (
            adminId == request.auth.token.email ||
            adminId == request.auth.token.email.split('@')[0] ||
            (resource.data.email != null && resource.data.email.lower() == request.auth.token.email.lower())
          ))
        ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'approved', 'isAdmin'])
      );
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    match /institution_settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    match /institution/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    match /app_updates/{docId} {
      allow read: if true;
      allow write: if isAdmin();
      match /{document=**} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Lecturers collection: managed by admins; lecturers can create/update own device and profile settings
    match /lecturers/{lecturerId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (
        isSignedIn() && (
          request.auth.uid == lecturerId ||
          (request.auth.token.email != null && (
            lecturerId == request.auth.token.email ||
            lecturerId == request.auth.token.email.lower() ||
            lecturerId == request.auth.token.email.split('@')[0] ||
            lecturerId == request.auth.token.email.split('@')[0].lower() ||
            lecturerId.lower() == request.auth.token.email.lower() ||
            lecturerId.lower() == request.auth.token.email.split('@')[0].lower()
          ))
        ) && !request.resource.data.keys().hasAny(['isAdmin', 'isSuperAdmin'])
      );
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() && (
          request.auth.uid == lecturerId ||
          (request.auth.token.email != null && (
            lecturerId == request.auth.token.email ||
            lecturerId == request.auth.token.email.lower() ||
            lecturerId == request.auth.token.email.split('@')[0] ||
            lecturerId == request.auth.token.email.split('@')[0].lower() ||
            lecturerId.lower() == request.auth.token.email.lower() ||
            lecturerId.lower() == request.auth.token.email.split('@')[0].lower() ||
            (resource.data.email != null && resource.data.email.lower() == request.auth.token.email.lower())
          ))
        ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'department', 'designation', 'status', 'approved', 'isAdmin'])
      );
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isAdmin() || (
          isSignedIn() && (
            request.auth.uid == lecturerId ||
            (request.auth.token.email != null && (
              lecturerId.lower() == request.auth.token.email.lower() ||
              lecturerId.lower() == request.auth.token.email.split('@')[0].lower()
            ))
          )
        );
      }
    }

    // Courses collection: managed by admins and authorized lecturers
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }
    }

    // Students collection: records managed by staff.
    // Students can update their own profile, faceDescriptor, and biometric hardware keys, but cannot alter rollNo, status, role, or device lock.
    match /students/{studentId} {
      allow get: if isStaff() || isOwnStudentRecord(studentId, resource.data);
      allow list: if isStaff() || (
        isSignedIn() && request.auth.token.email != null && (
          resource.data.email == request.auth.token.email ||
          resource.data.email == request.auth.token.email.lower()
        )
      );
      allow create: if isStaff() || (
        hasNoFaceTemplate(request.resource.data) &&
        (!('faceRegistered' in request.resource.data) || request.resource.data.faceRegistered == false) &&
        (!('biometricEnrolled' in request.resource.data) || request.resource.data.biometricEnrolled == false) &&
        (!('hasFaceRegistered' in request.resource.data) || request.resource.data.hasFaceRegistered == false) &&
        isSignedIn() &&
        (
          request.auth.uid == studentId ||
          (request.resource.data.studentUid != null && request.resource.data.studentUid == request.auth.uid) ||
          (request.auth.token.email != null && request.resource.data.email != null && (request.resource.data.email == request.auth.token.email || request.resource.data.email.lower() == request.auth.token.email.lower()))
        ) &&
        !request.resource.data.keys().hasAny(['disqualified', 'isAdmin', 'isStaff']) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'student') &&
        (!('status' in request.resource.data) || request.resource.data.status in ['active', 'pending'])
      );
      allow delete: if isStaff();
      allow update: if isStaff() || (
        canEnrollOrModifyBiometrics() &&
        isSignedIn() &&
        isOwnStudentRecord(studentId, resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'rollNo', 'rollNumber', 'status', 'disqualified', 'academicYear', 'department', 'batch', 'role', 'studentUid'
        ]) &&
        // Prevent unlocking an already locked device from client side
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deviceTypeLocked']) ||
          (resource.data.deviceTypeLocked != true && request.resource.data.deviceTypeLocked == true)
        )
      );
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }
    }

    // Users collection: users can create/update own profile, staff can manage
    match /users/{userId} {
      allow get: if isStaff() || isOwnUserRecord(userId, resource.data);
      allow list: if isStaff() || (
        isSignedIn() && request.auth.token.email != null && (
          resource.data.email == request.auth.token.email ||
          resource.data.email == request.auth.token.email.lower()
        )
      );
      allow create: if isStaff() || (
        hasNoFaceTemplate(request.resource.data) &&
        (!('faceRegistered' in request.resource.data) || request.resource.data.faceRegistered == false) &&
        (!('biometricEnrolled' in request.resource.data) || request.resource.data.biometricEnrolled == false) &&
        (!('hasFaceRegistered' in request.resource.data) || request.resource.data.hasFaceRegistered == false) &&
        isSignedIn() && (
          (
            request.auth.uid == userId ||
            (request.resource.data.studentUid != null && request.resource.data.studentUid == request.auth.uid)
          ) &&
          !request.resource.data.keys().hasAny([
            'role', 'isAdmin', 'isLecturer', 'status', 'disqualified', 'department', 'batch'
          ])
        )
      );
      allow update: if isStaff() || (
        canEnrollOrModifyBiometrics() && isSignedIn() && (
          (
            request.auth.uid == userId ||
            (resource.data.studentUid != null && resource.data.studentUid == request.auth.uid) ||
            (request.auth.token.email != null && resource.data.email != null && (request.resource.data.email == request.auth.token.email || resource.data.email.lower() == request.auth.token.email.lower())) ||
            (request.auth.token.email != null && userId.lower() == request.auth.token.email.split('@')[0].lower())
          ) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'isAdmin', 'isLecturer', 'status', 'disqualified', 'department', 'batch'
          ]) &&
          (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
        )
      );
      allow delete: if isStaff();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }
    }

    match /authorizedUsers/{userId} {
      allow get: if isStaff() || isOwnUserRecord(userId, resource.data);
      allow list: if isStaff() || (
        isSignedIn() && request.auth.token.email != null && (
          resource.data.email == request.auth.token.email ||
          resource.data.email == request.auth.token.email.lower()
        )
      );
      allow create, update, delete: if isStaff();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }
    }

    match /face_enrollments/{studentId} {
      allow read, write: if false;
    }

    match /face_enrollment_control/{guardId} {
      allow read, write: if false;
    }

    match /face_enrollment_reviews/{reviewId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Notifications & Communications
    match /faculty_notifications/{notificationId} {
      allow read: if isStaff();
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
      match /{document=**} {
        allow read: if isStaff();
        allow write: if isStaff();
      }
    }

    match /admin_notifications/{notificationId} {
      allow read, write: if isAdmin();
      match /{document=**} {
        allow read, write: if isAdmin();
      }
    }

    match /lecturer_notifications/{notificationId} {
      allow read, write: if isStaff();
      match /{document=**} {
        allow read, write: if isStaff();
      }
    }

    match /broadcast_notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }
    }

    match /broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }
    }

    match /user_complaints/{complaintId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
      match /{document=**} {
        allow read: if isStaff();
        allow write: if isStaff();
      }
    }

    match /support_tickets/{ticketId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
      match /{document=**} {
        allow read: if isStaff();
        allow write: if isStaff();
      }
    }

    match /feedbacks/{feedbackId} {
      allow read: if isStaff();
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
      match /{document=**} {
        allow read: if isStaff();
        allow write: if isStaff();
      }
    }

    match /security_complaints/{complaintId} {
      allow read: if isStaff();
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
      match /{document=**} {
        allow read: if isStaff();
        allow write: if isStaff();
      }
    }

    match /student_notifications/{studentRollNo} {
      allow read, write: if isSignedIn();
      match /{document=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isStaff();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }
    }

    // =========================================================================
    // ATTENDANCE SESSIONS & SECURITY TOKENS
    // =========================================================================

    match /attendance_sessions/{sessionId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && isStaff();

      allow delete: if isSignedIn() && (
        isAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        (request.auth.token.email != null && resource.data.ownerEmail != null && resource.data.ownerEmail.lower() == request.auth.token.email.lower())
      );

      // Session phase, lifecycle, deadlines, ownership, release codes and QR secrets
      // are server-controlled. Callable Cloud Functions use Admin SDK and bypass these rules.
      allow update: if isSignedIn() &&
        (isAdmin() || (isLecturer() && (
          resource.data.ownerId == request.auth.uid ||
          (request.auth.token.email != null && resource.data.ownerEmail != null && resource.data.ownerEmail.lower() == request.auth.token.email.lower())
        ))) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'phase', 'qr2Released', 'qr1ExpiresAt', 'qr2StartsAt', 'active', 'status',
          'ownerId', 'ownerEmail', 'sessionPin', 'lecturerPin', 'releaseCodeHash',
          'rawReleaseCodeHash', 'qr1Token', 'qr2Token', 'qr1TokenHash', 'qr2TokenHash',
          'kioskEndsAt', 'expiresAt'
        ]);

      match /security/{docId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          (isLecturer() && (
            (resource.data != null && (
              resource.data.ownerId == request.auth.uid ||
              (request.auth.token.email != null && resource.data.ownerEmail != null && resource.data.ownerEmail.lower() == request.auth.token.email.lower())
            )) ||
            (exists(/databases/$(database)/documents/attendance_sessions/$(sessionId)) && (
              get(/databases/$(database)/documents/attendance_sessions/$(sessionId)).data.ownerId == request.auth.uid ||
              (request.auth.token.email != null && get(/databases/$(database)/documents/attendance_sessions/$(sessionId)).data.ownerEmail != null && get(/databases/$(database)/documents/attendance_sessions/$(sessionId)).data.ownerEmail.lower() == request.auth.token.email.lower())
            ))
          ))
        );
        allow create: if isSignedIn() && (
          isAdmin() ||
          (isStaff() && (
            request.resource.data.ownerId == request.auth.uid ||
            (request.auth.token.email != null && request.resource.data.ownerEmail != null && request.resource.data.ownerEmail.lower() == request.auth.token.email.lower())
          ))
        );
        allow update: if isSignedIn() && (
          isAdmin() ||
          (isLecturer() && (
            (resource.data != null && (
              resource.data.ownerId == request.auth.uid ||
              (request.auth.token.email != null && resource.data.ownerEmail != null && resource.data.ownerEmail.lower() == request.auth.token.email.lower())
            )) ||
            (exists(/databases/$(database)/documents/attendance_sessions/$(sessionId)) && (
              get(/databases/$(database)/documents/attendance_sessions/$(sessionId)).data.ownerId == request.auth.uid ||
              (request.auth.token.email != null && get(/databases/$(database)/documents/attendance_sessions/$(sessionId)).data.ownerEmail != null && get(/databases/$(database)/documents/attendance_sessions/$(sessionId)).data.ownerEmail.lower() == request.auth.token.email.lower())
            ))
          ))
        );
        allow delete: if isAdmin() || (
          isSignedIn() && (
            (resource.data != null && (
              resource.data.ownerId == request.auth.uid ||
              (request.auth.token.email != null && resource.data.ownerEmail != null && resource.data.ownerEmail.lower() == request.auth.token.email.lower())
            )) ||
            (exists(/databases/$(database)/documents/attendance_sessions/$(sessionId)) && (
              get(/databases/$(database)/documents/attendance_sessions/$(sessionId)).data.ownerId == request.auth.uid ||
              (request.auth.token.email != null && get(/databases/$(database)/documents/attendance_sessions/$(sessionId)).data.ownerEmail != null && get(/databases/$(database)/documents/attendance_sessions/$(sessionId)).data.ownerEmail.lower() == request.auth.token.email.lower())
            ))
          )
        );
        match /{document=**} {
          allow read: if isSignedIn() && (
            isAdmin() ||
            (isLecturer() && (
              (resource.data != null && (
                resource.data.ownerId == request.auth.uid ||
                (request.auth.token.email != null && resource.data.ownerEmail != null && resource.data.ownerEmail.lower() == request.auth.token.email.lower())
              )) ||
              (exists(/databases/$(database)/documents/attendance_sessions/$(sessionId)) && (
                get(/databases/$(database)/documents/attendance_sessions/$(sessionId)).data.ownerId == request.auth.uid ||
                (request.auth.token.email != null && get(/databases/$(database)/documents/attendance_sessions/$(sessionId)).data.ownerEmail != null && get(/databases/$(database)/documents/attendance_sessions/$(sessionId)).data.ownerEmail.lower() == request.auth.token.email.lower())
              ))
            ))
          );
          allow write: if false;
        }
      }

      // Authorizations subcollection: student devices and lecturers
      // Authorizations subcollection: student devices and lecturers
      match /authorizations/{authDocId} {
        // Students may read only their own authorization record. Staff access is
        // retained for the lecturer's live supervision dashboard.
        allow read: if isStaff() || (
          isSignedIn() && (
            request.auth.uid == authDocId ||
            resource.data.studentUid == request.auth.uid ||
            (request.auth.token.email != null && resource.data.studentEmail != null &&
              resource.data.studentEmail.lower() == request.auth.token.email.lower())
          )
        );
        // Only trusted server functions may create QR1 authorization records.
        // A student cannot self-assert qr1Verified/status by writing directly to Firestore.
        allow create: if false;
        allow delete: if isStaff();
        allow update: if isStaff() || (
          isSignedIn() &&
          (
            request.auth.uid == authDocId ||
            (resource.data.studentUid != null && resource.data.studentUid == request.auth.uid) ||
            (request.auth.token.email != null && resource.data.studentEmail != null &&
              resource.data.studentEmail.lower() == request.auth.token.email.lower())
          ) &&
          // Student clients may update presence/telemetry only, never authorization,
          // biometric verdicts, violations, release state, or attendance state.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastHeartbeat', 'clientTimestamp', 'detectedPlatform', 'deviceIp',
            'userAgent', 'studentLocation', 'lastActiveAt', 'distance',
            'classroomDistance', 'verificationStage'
          ])
        );
        match /{document=**} {
          allow read: if isStaff();
          allow write: if false;
        }
      }

      match /violations/{violationId} {
        // Only trusted Cloud Functions may create violation records. Students
        // cannot forge violations or read other students' violation history.
        allow read: if isStaff() || (
          isSignedIn() &&
          exists(/databases/$(database)/documents/attendance_sessions/$(sessionId)/authorizations/$(request.auth.uid))
        );
        allow create: if false;
        allow update, delete: if isStaff();
        match /{document=**} {
          allow read: if isStaff();
          allow write: if false;
        }
      }

      match /audit_logs/{logId} {
        allow read, write: if isStaff();
        match /{document=**} {
          allow read: if isStaff();
          allow write: if false;
        }
      }

      // Time adjustments audit records: only Cloud Functions Admin SDK can write
      match /time_adjustments/{adjustmentId} {
        allow read: if isStaff();
        allow write: if false;
        match /{document=**} {
          allow read: if isStaff();
          allow write: if false;
        }
      }

      // Geofence adjustments audit records: only Cloud Functions Admin SDK can write
      match /geofence_adjustments/{adjustmentId} {
        allow read: if isStaff();
        allow write: if false;
        match /{document=**} {
          allow read: if isStaff();
          allow write: if false;
        }
      }
    }

    // =========================================================================
    // BIOMETRIC SECURITY & HARDWARE CREDENTIALS
    // =========================================================================

    match /biometric_credentials/{docId} {
      allow read: if isStaff() || (isSignedIn() && (docId == request.auth.uid || resource.data.studentUid == request.auth.uid));
      // Authoritative key enrollment is strictly handled via Cloud Functions Admin SDK or Staff
      allow create, update, delete: if isStaff();
      match /{document=**} {
        allow read: if isStaff() || (isSignedIn() && (docId == request.auth.uid || resource.data.studentUid == request.auth.uid));
        allow write: if isStaff();
      }
    }

    match /biometric_reregistration_permissions/{permId} {
      allow read: if isStaff() || (
        isSignedIn() && (
          resource.data.targetStudentUid == request.auth.uid ||
          resource.data.rollNo == request.auth.uid ||
          resource.data.studentRollNo == request.auth.uid ||
          permId == request.auth.uid ||
          (request.auth.token.email != null && (
            permId.lower() == request.auth.token.email.split('@')[0].lower() ||
            (resource.data.targetRollNo != null && resource.data.targetRollNo.lower() == request.auth.token.email.split('@')[0].lower()) ||
            (resource.data.rollNo != null && resource.data.rollNo.lower() == request.auth.token.email.split('@')[0].lower()) ||
            (resource.data.studentRollNo != null && resource.data.studentRollNo.lower() == request.auth.token.email.split('@')[0].lower())
          ))
        )
      );
      allow write: if isStaff();
      match /{document=**} {
        allow read: if isStaff() || (
          isSignedIn() && (
            resource.data.targetStudentUid == request.auth.uid ||
            resource.data.rollNo == request.auth.uid ||
            resource.data.studentRollNo == request.auth.uid ||
            permId == request.auth.uid ||
            (request.auth.token.email != null && (
              permId.lower() == request.auth.token.email.split('@')[0].lower() ||
              (resource.data.targetRollNo != null && resource.data.targetRollNo.lower() == request.auth.token.email.split('@')[0].lower()) ||
              (resource.data.rollNo != null && resource.data.rollNo.lower() == request.auth.token.email.split('@')[0].lower()) ||
              (resource.data.studentRollNo != null && resource.data.studentRollNo.lower() == request.auth.token.email.split('@')[0].lower())
            ))
          )
        );
        allow write: if isStaff();
      }
    }

    match /reregistration_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isStaff() || (isSignedIn() && (
        resource.data.studentRollNo == request.auth.uid ||
        resource.data.rollNo == request.auth.uid ||
        requestId == request.auth.uid ||
        (request.auth.token.email != null && (
          (resource.data.studentEmail != null && resource.data.studentEmail.lower() == request.auth.token.email.lower()) ||
          requestId.lower() == request.auth.token.email.split('@')[0].lower() ||
          (resource.data.rollNo != null && resource.data.rollNo.lower() == request.auth.token.email.split('@')[0].lower()) ||
          (resource.data.studentRollNo != null && resource.data.studentRollNo.lower() == request.auth.token.email.split('@')[0].lower())
        ))
      ));
      allow delete: if isStaff();
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isStaff();
      }
    }

    match /biometric_challenges/{docId} {
      allow read: if isStaff() || (isSignedIn() && (docId == request.auth.uid || resource.data.studentUid == request.auth.uid));
      allow create: if isStaff() || (isSignedIn() && request.resource.data.studentUid == request.auth.uid);
      allow update: if isStaff() || (isSignedIn() && resource.data.studentUid == request.auth.uid);
      allow delete: if isStaff();
      match /{document=**} {
        allow read: if isStaff() || (isSignedIn() && (docId == request.auth.uid || resource.data.studentUid == request.auth.uid));
        allow write: if isStaff();
      }
    }

    match /biometric_audit_logs/{docId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /biometric_change_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.studentUid == request.auth.uid || isStaff()
      );
      allow create: if isSignedIn() &&
        request.resource.data.studentUid == request.auth.uid &&
        request.resource.data.status == "PENDING";
      allow update: if isStaff();
      allow delete: if false;
    }

    match /attendance_records/{recordId} {
      allow read: if isStaff() || (isSignedIn() && (
        resource.data.studentUid == request.auth.uid ||
        (request.auth.token.email != null && resource.data.studentEmail != null && resource.data.studentEmail.lower() == request.auth.token.email.lower()) ||
        (request.auth.token.email != null && resource.data.rollNo != null && (
          resource.data.rollNo.lower() == request.auth.token.email.split('@')[0].lower() ||
          resource.data.rollNo == request.auth.token.email.split('@')[0].upper()
        ))
      ));
      allow create, update: if isStaff() || (
        isSignedIn() && (
          request.resource.data.studentUid == request.auth.uid ||
          (request.auth.token.email != null && request.resource.data.studentEmail != null && request.resource.data.studentEmail.lower() == request.auth.token.email.lower()) ||
          (request.auth.token.email != null && request.resource.data.rollNo != null && (
            request.resource.data.rollNo.lower() == request.auth.token.email.split('@')[0].lower() ||
            request.resource.data.rollNo == request.auth.token.email.split('@')[0].upper()
          ))
        )
      );
      allow delete: if isStaff();
      match /{document=**} {
        allow read: if isStaff() || (isSignedIn() && (
          resource.data.studentUid == request.auth.uid ||
          (request.auth.token.email != null && resource.data.studentEmail != null && resource.data.studentEmail.lower() == request.auth.token.email.lower()) ||
          (request.auth.token.email != null && resource.data.rollNo != null && (
            resource.data.rollNo.lower() == request.auth.token.email.split('@')[0].lower() ||
            resource.data.rollNo == request.auth.token.email.split('@')[0].upper()
          ))
        ));
        allow write: if isStaff();
      }
    }
  }
}
